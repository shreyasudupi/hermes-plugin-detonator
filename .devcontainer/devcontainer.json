{
  "name": "hermes-plugin-detonator",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    },
    "codespaces": {
      "repositories": {
        "shreyasudupi/detonator-test-fixtures": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  },
  "remoteUser": "vscode"
}
