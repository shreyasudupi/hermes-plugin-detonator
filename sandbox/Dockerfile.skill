# Sandbox image for skills: a full Debian image with Python plus Node.js, because skills tell the
# agent to run everyday command-line tools (curl, wget, git, unzip, ssh), Python and Node scripts.
# A slim image would make most of those commands fail with "not found" and hide what they do.
# Built only when /detonate-skill is used. Both base images are pinned by digest (multi-arch
# index), so every build is identical and no package manager runs during the build.
# Same rules as the plugin sandbox at run time: --network none (or the fake internet),
# read-only root, no capabilities, non-root user.
FROM node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS node

FROM python:3.11-bookworm@sha256:726d304906fa5eb468e5531e366548d1903286352f5adb54ef508ac01fbd80c6

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY harness.py mcp_harness.py skill_harness.py /opt/detonator/

USER 10001
ENTRYPOINT ["python", "-I", "-B", "/opt/detonator/harness.py"]
